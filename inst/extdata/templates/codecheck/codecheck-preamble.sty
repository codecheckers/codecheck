%% ORCID icon as clickable link. Loaded directly from the academicons TTF
%% (shipped with the academicons LaTeX package) by filename via \newfontface,
%% rather than through the academicons package's \aiOrcid command. \aiOrcid
%% selects the font by OS-level family name via fontspec's \newfontfamily,
%% which silently falls back to a legacy 8-bit TFM with no ORCID glyph on
%% systems where the font isn't registered with the OS font system
%% (fontconfig) - producing no visible icon with no compile error. Loading by
%% filename resolves the font via TeX's own search path instead, so it works
%% regardless of OS font registration.
\newfontface\orcidfont{academicons.ttf}
\definecolor{orcidlogocol}{HTML}{A6CE39}
\newcommand\orcidicon[1]{\href{https://orcid.org/#1}{\textcolor{orcidlogocol}{\orcidfont\symbol{"E9D9}}}}
